# ============================================================
# GEO Escrow — contoh environment (TANPA nilai rahasia)
# ============================================================
# Salin ke .env.local (lokal) atau isi di panel hosting (Vercel → Settings →
# Environment Variables). .env.local TIDAK dilacak git (.gitignore: .env*).
# Jangan pernah mengisi nilai asli di file ini.

# ---- Supabase (server saja — service_role melewati RLS) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key — RAHASIA>

# ---- Blockchain ----
# true = transaksi & sinkronisasi sungguhan ke kontrak. Di produksi WAJIB true.
CHAIN_ENABLED=true
GEO_ESCROW_ADDRESS=0x41462F3092Ca66b7B3d9c8b20337793e2756cC46
# RPC untuk SERVER (boleh berkunci, mis. Alchemy/QuickNode — tidak pernah ke browser).
RPC_URL=https://bsc-testnet-rpc.publicnode.com
# RPC untuk BROWSER (wagmi). Terlihat publik — JANGAN pakai URL berkunci di sini.
# Origin-nya otomatis diizinkan di CSP (next.config.ts connect-src) saat build.
NEXT_PUBLIC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Kunci wallet ORACLE (64 heksa). Wallet ini harus = oracle() di kontrak dan punya tBNB.
ORACLE_PRIVATE_KEY=<64-hex — RAHASIA>

# ---- Oracle AI ----
# mock (pengembangan, gratis, hasil bisa dihitung di muka) | claude (deploy)
ORACLE_PROVIDER=mock
ANTHROPIC_API_KEY=<sk-ant-... — RAHASIA, wajib bila ORACLE_PROVIDER=claude>
# Mock di produksi DITOLAK kecuali ini true (deploy demo yang memang memakai mock).
ALLOW_MOCK_ORACLE_IN_PRODUCTION=false
# Kuota panggilan AI sungguhan per 24 jam (dihitung dari oracle_runs). Kosong = default.
ORACLE_DAILY_CALL_LIMIT=400
ORACLE_CLIENT_DAILY_CALL_LIMIT=60

# ---- Operasional ----
# Rahasia untuk GET /api/indexer/poll (cron) & jalur internal baseline. Acak ≥ 32 karakter.
# Kosong = endpoint cron TERTUTUP (bukan terbuka).
CRON_SECRET=<acak — RAHASIA>
